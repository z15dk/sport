# Public address of the site, used for canonical URLs, sitemap and structured data
SITE_URL=http://localhost:5173

# Set to "true" only when the site shows real results. Until then every page is
# noindex and robots.txt blocks crawlers, so fictional results never get indexed.
SITE_INDEXABLE=false

# TheSportsDB API key ("123" is the free key; the old "3" is mapped to it)
THESPORTSDB_KEY=123
NEXT_PUBLIC_THESPORTSDB_KEY=123

# Real fixtures and results for the leagues in src/data/real.ts (Superliga).
# Set REAL_DATA=off to show only fictional results.
# REAL_DATA=off

# Hide the advertising placeholders until real ads are in place
# NEXT_PUBLIC_AD_PLACEHOLDERS=false

# API-Sports (api-sports.io): one key for all sports, or one per sport
# (API_SPORTS_KEY_FOOTBALL, _BASKETBALL, _NBA, _HOCKEY, _HANDBALL, _VOLLEYBALL, _AMERICAN_FOOTBALL)
API_SPORTS_KEY=

# Password for the admin pages (/admin). Without it the admin pages are closed.
ADMIN_PASSWORD=

# IndexNow key (8-128 letters, digits or dashes). Only used when SITE_INDEXABLE=true.
# Generate one with: openssl rand -hex 16
INDEXNOW_KEY=
