# Public address of the site, used for canonical URLs, sitemap and structured data
SITE_URL=http://localhost:5173

# Set to "true" only when the site shows real results. Until then every page is
# noindex and robots.txt blocks crawlers, so fictional results never get indexed.
SITE_INDEXABLE=false

# TheSportsDB API key ("3" is the free test key)
THESPORTSDB_KEY=3
NEXT_PUBLIC_THESPORTSDB_KEY=3
