#!/usr/bin/env bash
# The Claude writers' only way to the site (deploy/claude-editor): it talks to Matchly on this server and nowhere
# else, so the writers need no curl and never see the keys in their environment.
# The editor (PROMPT.md):
#   matchly-api kladder              the new automatic drafts with their fact sheets (JSON)
#   matchly-api alle                 also the drafts already read
#   matchly-api gem <id> <fil.json>  saves the article in the file (in the writer's own folder) for draft <id>
# The news scout (NYHEDER.md):
#   matchly-api artikler             the newest 40 articles (titles, slugs, status) – what Matchly already has
#   matchly-api artikel <id>         one of its own drafts in full, with the checklist
#   matchly-api nyhed <fil.json>     saves a news draft {"action":"gem","article":{…}} → id and the checklist
#   matchly-api mail <id> [<id>…]    mails its drafts to the owner ("Læs og udgiv")
#   matchly-api billede <fil.json>   {"action":"billede","id":…,"kind":"resultat"|"vs"|"tekst"|"klub"|"liga",…} – the draft's picture (Matchly's own graphics)
#   matchly-api opslag <fil.json>    {"action":"opslag","id":…,"text":…} – the draft's social post text
#   matchly-api opdater <fil.json>   {"action":"opdater","id":…,"content":…,"why":…} – a statistics article with new numbers
#   matchly-api referater            the finished Superliga/1. division matches to write a fast report on (the referat round)
#   matchly-api referat <fil.json>   {"action":"skrevet","slug":…,"id":…}, {"action":"udgiv","slug":…} or {"action":"spring","slug":…,"why":…}
#   matchly-api datavagt             the night's findings and the coach list
#   matchly-api traener <fil.json>   {"action":"setCoach",…} or {"action":"removeCoach","slug":…}
#   matchly-api ret <fil.json>       {"action":"setGround"|"removeGround"|"setTv"|"matchRefetch"|"matchResult"|"matchHide",…,"why":…}
# The growth round (VAEKST.md):
#   matchly-api vaekst               the numbers: page views, Google, the pages close to page 1, rising/falling, title tests
#   matchly-api titel <fil.json>     {"action":"titel","path":…,"title":…,"description":…,"faq":[{"q":…,"a":…}],"query":…,"why":…}
#   matchly-api dom <fil.json>       {"action":"behold"|"fortryd","path":…,"why":…} – the verdict on a 14-day title test
#   matchly-api dagbog <fil.json>    {"action":"dagbog","text":…,"actions":[…],"numbers":{…}} – today's diary entry
# The quiz round (QUIZ.md):
#   matchly-api quiz                 the "Gæt klubben" series so far: the next number, the clubs used, whose answer comes next
#   matchly-api quiz-afsnit <fil.json> {"action":"afsnit","club":…,"level":…,"clues":[…],"caption":…,"answerNote":…} – the next episode's video
# Both:
#   matchly-api tjek </sti>          the HTTP status of a page on matchly.dk (e.g. /klub/ab → 200)
#   matchly-api side </sti>          a page on matchly.dk as plain text
#   matchly-api soeg <navn>          the site search (clubs and leagues with their slugs)
set -euo pipefail
: "${SITE:?}" "${EDITOR_TOKEN:?}"
auth=(-H "Authorization: Bearer ${EDITOR_TOKEN}")
# Only a plain file in the writer's own folder
jsonfile() { [[ "${1:-}" =~ ^[A-Za-z0-9._-]+\.json$ && -f "$1" ]] || { echo "Filen skal være en .json-fil i din egen mappe" >&2; exit 2; }; }
# Only a path on the site itself (no host, no spaces)
sitepath() { [[ "${1:-}" =~ ^/[A-Za-z0-9/_.%-]*$ ]] || { echo "Stien skal starte med / og kun indeholde bogstaver, tal og - _ . /" >&2; exit 2; }; }
post() { exec curl -sS -w '\nHTTP %{http_code}\n' -X POST "${auth[@]}" -H 'content-type: application/json' "${SITE}$1" --data-binary "@$2"; }
case "${1:-}" in
  kladder) exec curl -sS "${auth[@]}" "${SITE}/api/redaktor/kladder" ;;
  alle) exec curl -sS "${auth[@]}" "${SITE}/api/redaktor/kladder?alle=1" ;;
  gem)
    id="${2:-}"; file="${3:-}"
    [[ "$id" =~ ^[0-9]+$ ]] || { echo "Brug: matchly-api gem <id> <fil.json>" >&2; exit 2; }
    jsonfile "$file"; post "/api/redaktor/kladder/${id}" "$file"
    ;;
  artikler) exec curl -sS "${auth[@]}" "${SITE}/api/redaktor/nyheder" ;;
  artikel)
    [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo "Brug: matchly-api artikel <id>" >&2; exit 2; }
    exec curl -sS "${auth[@]}" "${SITE}/api/redaktor/nyheder?id=$2"
    ;;
  nyhed|billede|opslag|opdater) jsonfile "${2:-}"; post "/api/redaktor/nyheder" "$2" ;;
  mail)
    shift; [[ $# -gt 0 ]] || { echo "Brug: matchly-api mail <id> [<id>…]" >&2; exit 2; }
    for i in "$@"; do [[ "$i" =~ ^[0-9]+$ ]] || { echo "Id'er skal være tal" >&2; exit 2; }; done
    exec curl -sS -w '\nHTTP %{http_code}\n' -X POST "${auth[@]}" -H 'content-type: application/json' "${SITE}/api/redaktor/nyheder" --data "{\"action\":\"mail\",\"ids\":[$(IFS=,; echo "$*")]}"
    ;;
  datavagt) exec curl -sS "${auth[@]}" "${SITE}/api/redaktor/datavagt" ;;
  referater) exec curl -sS "${auth[@]}" "${SITE}/api/redaktor/referater" ;;
  referat) jsonfile "${2:-}"; post "/api/redaktor/referater" "$2" ;;
  vaekst) exec curl -sS "${auth[@]}" "${SITE}/api/redaktor/vaekst" ;;
  titel|dom|dagbog) jsonfile "${2:-}"; post "/api/redaktor/vaekst" "$2" ;;
  traener|ret) jsonfile "${2:-}"; post "/api/redaktor/datavagt" "$2" ;;
  quiz) exec curl -sS "${auth[@]}" "${SITE}/api/redaktor/quiz" ;;
  quiz-afsnit) jsonfile "${2:-}"; post "/api/redaktor/quiz" "$2" ;;
  tjek) sitepath "${2:-}"; exec curl -sS -o /dev/null -w '%{http_code} %{redirect_url}\n' "${SITE}$2" ;;
  side)
    sitepath "${2:-}"
    curl -sS -L "${SITE}$2" | sed -e 's/<script[^>]*>[^<]*<\/script>//g' -e 's/<style[^>]*>[^<]*<\/style>//g' -e 's/<[^>]*>/ | /g' | tr -s ' |\n' | head -c 40000
    echo
    ;;
  soeg) exec curl -sS --get --data-urlencode "q=${2:-}" "${SITE}/api/search" ;;
  *) echo "Brug: matchly-api kladder | alle | gem <id> <fil.json> | artikler | artikel <id> | nyhed <fil.json> | billede <fil.json> | opslag <fil.json> | opdater <fil.json> | mail <id>… | referater | referat <fil.json> | datavagt | traener <fil.json> | ret <fil.json> | vaekst | titel <fil.json> | quiz | quiz-afsnit <fil.json> | dom <fil.json> | dagbog <fil.json> | tjek </sti> | side </sti> | soeg <navn>" >&2; exit 2 ;;
esac
