# Claude som redaktør (matchly-editor.timer): læser de automatiske optakter og referater igennem, tjekker fakta
# på nettet og skriver en vurdering. Egen bruger uden adgang til sitets data og hemmeligheder; kun curl mod
# sitets redaktør-API og websøgning. Lav prioritet og loft over hukommelse, så siden altid går forud.
[Unit]
Description=Matchly: Claude læser de automatiske kladder igennem
After=network-online.target scoreline.service
Wants=network-online.target

[Service]
Type=oneshot
User=matchly-editor
Group=matchly-editor
WorkingDirectory=/var/lib/matchly-editor
EnvironmentFile=/etc/matchly-editor.env
Environment=HOME=/var/lib/matchly-editor
# The newest script and prompt from the live release, copied as root into the editor's own folder before each run
ExecStartPre=+/usr/bin/install -D -o matchly-editor -g matchly-editor -m 500 -t /var/lib/matchly-editor/bin /opt/scoreline/current/deploy/claude-editor/run.sh /opt/scoreline/current/deploy/claude-editor/PROMPT.md
ExecStart=/var/lib/matchly-editor/bin/run.sh
Nice=15
CPUQuota=50%
MemoryMax=900M
TimeoutStartSec=45min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/matchly-editor /tmp
InaccessiblePaths=/opt/scoreline/data /opt/scoreline/env /opt/scoreline/google-sa.json
PrivateTmp=true
