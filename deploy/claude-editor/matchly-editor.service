# Claude som skribent (matchly-editor.timer): skriver de automatiske optakter og referater om, tjekker fakta på
# nettet og skriver en vurdering. Egen bruger uden adgang til sitets data og hemmeligheder; kun matchly-api mod
# sitets redaktør-API, websøgning og egen mappe. Lav prioritet og loft over hukommelse, så siden altid går forud.
[Unit]
Description=Matchly: Claude læser de automatiske kladder igennem
After=network-online.target scoreline.service
Wants=network-online.target

[Service]
Type=oneshot
User=matchly-editor
Group=matchly-editor
WorkingDirectory=/var/lib/matchly-editor
EnvironmentFile=/etc/matchly-editor.env
Environment=HOME=/var/lib/matchly-editor
# The newest script and prompt from the live release, copied as root into the editor's own folder before each run
ExecStartPre=+/usr/bin/install -D -o matchly-editor -g matchly-editor -m 500 -t /var/lib/matchly-editor/bin /opt/scoreline/current/deploy/claude-editor/run.sh /opt/scoreline/current/deploy/claude-editor/matchly-api /opt/scoreline/current/deploy/claude-editor/PROMPT.md
ExecStart=/var/lib/matchly-editor/bin/run.sh
Nice=15
CPUQuota=50%
MemoryMax=900M
TimeoutStartSec=90min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/matchly-editor /tmp
InaccessiblePaths=/opt/scoreline/data /opt/scoreline/env /opt/scoreline/google-sa.json
PrivateTmp=true
# Shut away from the rest of the machine (systemd-analyze security): no devices, kernel, clocks, other processes,
# new privileges or odd sockets – only the network (web search, the site's API) and its own folder
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
