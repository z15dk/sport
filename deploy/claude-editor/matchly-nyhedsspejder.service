# Nyhedsspejderen (matchly-nyhedsspejder.timer): finder morgenens fodboldnyheder, skriver 1–2 nyhedskladder,
# mailer dem til ejeren og retter trænerlisten. Samme bruger, nøgle og spærringer som skribenten
# (matchly-editor.service): kun matchly-api, websøgning og egen mappe. Lav prioritet, så siden altid går forud.
[Unit]
Description=Matchly: nyhedsspejderen skriver morgenens nyhedskladder
After=network-online.target scoreline.service
Wants=network-online.target

[Service]
Type=oneshot
User=matchly-editor
Group=matchly-editor
WorkingDirectory=/var/lib/matchly-editor
EnvironmentFile=/etc/matchly-editor.env
Environment=HOME=/var/lib/matchly-editor
# The newest script and prompt from the live release, copied as root into the editor's own folder before each run
# Started from admin ("Find nyheder nu", matchly-nyhedsspejder.path): the request is turned into a mark in the scout's own
# folder (the run itself can't see /opt/scoreline/data), so this run is the extra round; then the request goes
ExecStartPre=+/bin/sh -c 'if [ -e /opt/scoreline/data/spejder-request ]; then install -d -o matchly-editor -g matchly-editor -m 700 /var/lib/matchly-editor/nyheder && install -o matchly-editor -g matchly-editor -m 600 /dev/null /var/lib/matchly-editor/nyheder/ekstra; rm -f /opt/scoreline/data/spejder-request; fi'
ExecStartPre=+/usr/bin/install -D -o matchly-editor -g matchly-editor -m 500 -t /var/lib/matchly-editor/spejder-bin /opt/scoreline/current/deploy/claude-editor/run-nyheder.sh /opt/scoreline/current/deploy/claude-editor/matchly-api /opt/scoreline/current/deploy/claude-editor/NYHEDER.md
ExecStart=/var/lib/matchly-editor/spejder-bin/run-nyheder.sh
Nice=15
CPUQuota=50%
MemoryMax=900M
TimeoutStartSec=75min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/matchly-editor /tmp
InaccessiblePaths=/opt/scoreline/data /opt/scoreline/env /opt/scoreline/google-sa.json
PrivateTmp=true
# Shut away from the rest of the machine (systemd-analyze security): no devices, kernel, clocks, other processes,
# new privileges or odd sockets – only the network (web search, the site's API) and its own folder
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
