# DBU-kampsiderne én gang i timen kl. 15-21 (dansk tid), kun mandag og fredag til søndag (Superligaen spiller også mandag). Kampe på andre
# dage, og kampe der slutter efter kl. 21, læses af natkørslen (scoreline-photos-nat.timer). En kørsel der stadig er i gang, springes blot over.
# Kampene læses først 105 minutter efter kampstart og derefter ved hver kørsel, til siden har resultatet. Højst én kørsel i timen,
# så DBU ikke oplever os som en bot; ingen kamp klar betyder ingen forespørgsler.
[Unit]
Description=Matchly DBU kampsider hver time kl. 15-21, mandag og fredag til søndag

[Timer]
OnCalendar=Mon,Fri..Sun *-*-* 15..21:07:00 Europe/Copenhagen
Persistent=false

[Install]
WantedBy=timers.target
